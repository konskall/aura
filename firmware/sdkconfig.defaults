CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Four data lines to the flash instead of two: code that is not in the 16 KB
# instruction cache (LVGL's drawing, Synapse) comes in twice as fast.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# The first flash (2026-11-14): the board ran out of internal RAM at boot, and a
# 4 KiB task stack, a mutex and the Bluetooth controller could not be allocated.
# malloc() blocks up to 16 KiB went to internal RAM first and took it from what
# must live there (task stacks, FreeRTOS objects, DMA, Bluetooth). Now malloc()
# takes PSRAM first, whatever the size, and internal RAM only if PSRAM is full;
# 64 KiB stay reserved for allocations that ask for internal or DMA memory.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Wi-Fi's and lwIP's buffers in PSRAM, and Wi-Fi's code out of IRAM (it shares
# the internal RAM with the heap); Wi-Fi is a little slower, AURA streams at
# most a 128 kbit/s station.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# An upload keeps 16 KB in flight, not ESP-IDF's 5760 bytes: a question's
# recording reached Groq at 20-58 KB/s, one window a round trip, and with
# Bluetooth on the radio dozes, so a round trip took 100-250 ms (2026-11-16).
# The buffers are lwIP's, in PSRAM.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
# The name the router lists for AURA (sent with DHCP), instead of ESP-IDF's
# "espressif" (the owner's request, 2026-11-14). Host names allow only letters,
# digits and hyphens: no spaces.
CONFIG_LWIP_LOCAL_HOSTNAME="Aura-Ai-Assistant"
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_FREERTOS_HZ=1000
# app_main runs the UI loop: screens are built there (LVGL objects, layout,
# formatted text) and the assistant's answers are parsed there. The default
# 3.5 KiB is far too little for that; the metrics line reports what is left
# (2026-11-14, before the first flash).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# The event task runs the Wi-Fi handlers: the saved network read at start, and
# a new one written to NVS once it connects, then SNTP started. Its default
# 2304 bytes kept 604 free at the least on the board (2026-11-19) before that
# write ever ran. The inter-core tasks kept 384 and 472 of their 1280.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_IPC_TASK_STACK_SIZE=1536
# A crash on the board leaves its backtrace in the coredump partition, read
# later with `idf.py coredump-info` even without a monitor attached.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_LV_USE_QRCODE=y
# The icons are stored RLE-compressed (tools/icons/lvgl-a8-image.mjs).
CONFIG_LV_USE_RLE=y
CONFIG_LV_BIN_DECODER_RAM_LOAD=y
# LVGL allocates through the C library, so its widgets and the transient layers
# it draws a faded or transformed widget through (tens to hundreds of KiB) live
# in PSRAM (CONFIG_SPIRAM_USE_MALLOC, CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0).
# LVGL's own pool is a fixed 64 KiB: a layer that does not fit fails, and LVGL
# silently leaves that widget undrawn.
CONFIG_LV_USE_CLIB_MALLOC=y
# LVGL's default break characters without ':', so a time ("19:30") never wraps
# at its colon; the simulator's lv_conf.h uses the same list.
CONFIG_LV_TXT_BREAK_CHARS=" ,.;-_)]}"
# Required by the Aoraton E2EE v2 codec (mbedtls_hkdf); ESP-IDF defaults it to n.
CONFIG_MBEDTLS_HKDF_C=y
# v13 companion: iPhone notifications over BLE (NimBLE, peripheral with a GATT client, bonds in NVS).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# ESP-IDF 5.5 offers the GATT client (needed to read ANCS from the iPhone) only with the central role.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# v13 companion: OTA with rollback and the CA bundle for the HTTPS update source.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Performance and internal RAM (2026-10-24): the ESP32-S3 at full speed, an
# optimised build, and the BLE host and mbedTLS allocating from PSRAM so that
# Wi-Fi, BLE and HTTPS together leave internal RAM free.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Dynamic frequency scaling (2026-11-05): app_main holds the processor at
# 240 MHz while the screen is lit and lets it drop to 80 MHz when it is dark.
# No automatic light sleep yet: it needs measurements on the board first.
CONFIG_PM_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# NVS (the Wi-Fi password, Aoraton keys, settings) is encrypted (2026-11-05,
# the owner's choice). Its XTS keys come from the HMAC peripheral and a key in
# eFuse block 5 that the first boot burns at random: no software can read it,
# and it does not limit flashing or debugging. Production
# (sdkconfig.production.defaults) keeps them in flash-encrypted nvs_keys instead.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5
# Local photo library and companion preferences need long UTF-8 FAT32 names.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
