CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_LV_USE_QRCODE=y
# LVGL allocates through the C library. Its widgets stay in internal RAM, and the
# transient layers it draws a faded or transformed widget through (tens to
# hundreds of KiB) go to PSRAM, as malloc() places blocks above 16 KiB there
# (CONFIG_SPIRAM_USE_MALLOC). LVGL's own pool is a fixed 64 KiB: a layer that
# does not fit fails, and LVGL silently leaves that widget undrawn.
CONFIG_LV_USE_CLIB_MALLOC=y
# LVGL's default break characters without ':', so a time ("19:30") never wraps
# at its colon; the simulator's lv_conf.h uses the same list.
CONFIG_LV_TXT_BREAK_CHARS=" ,.;-_)]}"
# Required by the Aoraton E2EE v2 codec (mbedtls_hkdf); ESP-IDF defaults it to n.
CONFIG_MBEDTLS_HKDF_C=y
# v13 companion: iPhone notifications over BLE (NimBLE, peripheral with a GATT client, bonds in NVS).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# ESP-IDF 5.5 offers the GATT client (needed to read ANCS from the iPhone) only with the central role.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# v13 companion: OTA with rollback and the CA bundle for the HTTPS update source.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Performance and internal RAM (2026-10-24): the ESP32-S3 at full speed, an
# optimised build, and the BLE host and mbedTLS allocating from PSRAM so that
# Wi-Fi, BLE and HTTPS together leave internal RAM free.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Dynamic frequency scaling (2026-11-05): app_main holds the processor at
# 240 MHz while the screen is lit and lets it drop to 80 MHz when it is dark.
# No automatic light sleep yet: it needs measurements on the board first.
CONFIG_PM_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# NVS (the Wi-Fi password, Aoraton keys, settings) is encrypted (2026-11-05,
# the owner's choice). Its XTS keys come from the HMAC peripheral and a key in
# eFuse block 5 that the first boot burns at random: no software can read it,
# and it does not limit flashing or debugging. Production
# (sdkconfig.production.defaults) keeps them in flash-encrypted nvs_keys instead.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5
# Local photo library and companion preferences need long UTF-8 FAT32 names.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
