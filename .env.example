# Local development only. scripts/dev-simulator.ps1 generates an ephemeral token.
AURA_BRIDGE_PORT=4778
AURA_CONTROLS_PORT=4777
AURA_BRIDGE_TOKEN=replace-with-a-random-local-token
AURA_PROVIDER=mock
# Optional tlesdetector server. AURA consumes its existing /api/weather and
# /api/opportunities routes; provider keys remain in tlesdetector and never enter AURA.
# HTTP is accepted only for loopback simulator development; devices require HTTPS.
AURA_TLESDETECTOR_URL=
